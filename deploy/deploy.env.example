# Copy to ../deploy.env (gitignored) and fill in. Generate secrets with: openssl rand -hex 24
DB_PASSWORD=
MAGIC_CODE_SECRET=
INSTANCE_ENCRYPTION_KEY=
# Browser-visible URL of the app (used for links / CORS). Change when behind a domain/HTTPS.
PUBLIC_URL=http://localhost:8180  # set to http://<LAN-IP>:8180 for LAN access
WEB_PORT=8180
